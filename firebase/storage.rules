rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile images — user can upload their own, anyone authenticated can read
    match /profile-images/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Event images — only admins can upload, anyone can read
    match /event-images/{eventId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Event brochures (JPG, PNG, PDF) — authenticated users can upload, anyone can read
    match /event-brochures/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
    }

    // Certificates (PDF, Images) — authenticated users can read/download, authenticated admins can upload
    match /certificates/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    }

    // Association members photos — anyone can read, authenticated admins/users can upload
    match /members/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
